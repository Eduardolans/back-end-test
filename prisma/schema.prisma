generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseType {
  A
  B
  C
}

enum VehicleType {
  coche
  moto
  camion
}

model User {
  id                    String              @id @default(uuid())
  nombre                String
  email                 String              @unique
  tipoPermiso           LicenseType         @map("tipo_permiso")
  permisoValidoHasta    DateTime            @map("permiso_valido_hasta")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  ownedVehicles         Vehicle[]           @relation("VehicleOwner")
  authorizedVehicles    AuthorizedDriver[]
  ownershipHistory      OwnershipHistory[]

  @@map("users")
}

model Vehicle {
  id                    String              @id @default(uuid())
  marca                 String
  modelo                String
  matricula             String              @unique
  tipo                  VehicleType
  propietarioId         String              @map("propietario_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  propietario           User                @relation("VehicleOwner", fields: [propietarioId], references: [id])
  authorizedDrivers     AuthorizedDriver[]
  ownershipHistory      OwnershipHistory[]

  @@map("vehicles")
}

model AuthorizedDriver {
  id          String    @id @default(uuid())
  vehicleId   String    @map("vehicle_id")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, userId])
  @@map("authorized_drivers")
}

model OwnershipHistory {
  id            String    @id @default(uuid())
  vehicleId     String    @map("vehicle_id")
  userId        String    @map("user_id")
  fechaInicio   DateTime  @map("fecha_inicio") @default(now())
  fechaFin      DateTime? @map("fecha_fin")
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("ownership_history")
}
